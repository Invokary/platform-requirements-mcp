{
  "name": "platform-requirements-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "A read-only MCP server for what Claude, ChatGPT, Cursor and the MCP Registry require before they list an MCP connector or plugin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evals": "vitest run evals",
    "tools:json": "node scripts/tools-json.ts",
    "data:sync": "node scripts/sync-data.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
