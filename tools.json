              "dateModified",
              "license",
              "attribution",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "platform",
          "requirements",
          "citation"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Get a platform's requirements",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
