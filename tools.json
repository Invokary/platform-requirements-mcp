{
  "endpoint": "https://mcp.invokary.com/mcp",
  "tools": [
    {
      "name": "list_platforms",
      "title": "List platforms",
      "description": "Lists the platforms in the Platform Requirements dataset (Claude, ChatGPT, Cursor and the Official MCP Registry): each one's directory, vendor, number of requirements, topics and latest check date. Use it to see what the dataset covers and which ids the other tools take.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "platforms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "vendor": {
                  "type": "string",
                  "minLength": 1
                },
                "surfaceName": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "requirementCount": {
                  "type": "number"
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "requirementCount": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "requirementCount"
                    ],
                    "additionalProperties": false
                  }
                },
                "lastChecked": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "vendor",
                "surfaceName",
                "url",
                "requirementCount",
                "topics"
              ],
              "additionalProperties": false
            }
          },
          "protocolRequirementCount": {
            "type": "number"
          },
          "citation": {
            "type": "object",
            "properties": {
              "dataset": {
                "type": "string"
              },
              "schemaVersion": {
                "type": "string"
              },
              "dateModified": {
                "type": "string"
              },
              "license": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "url"
                ],
                "additionalProperties": false
              },
              "attribution": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "dataset",
              "schemaVersion",
              "dateModified",
              "license",
              "attribution",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "platforms",
          "protocolRequirementCount",
          "citation"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "List platforms",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_platform_requirements",
      "title": "Get a platform's requirements",
      "description": "Returns what one platform requires before it lists an MCP connector or plugin, each requirement with its sources, evidence label and the date it was last checked. Narrow the list to one topic (category) or one product surface. Platforms: claude (Claude), chatgpt (ChatGPT), cursor (Cursor), mcp-registry (MCP Registry), ecosystem (MCP specification).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "claude",
              "chatgpt",
              "cursor",
              "mcp-registry",
              "ecosystem"
            ],
            "description": "The platform id."
          },
          "category": {
            "description": "Only requirements on this topic.",
            "type": "string",
            "enum": [
              "submission",
              "eligibility",
              "tiers",
              "analytics",
              "extensions",
              "auth",
              "rules",
              "limits",
              "distribution",
              "protocol"
            ]
          },
          "productSurface": {
            "description": "Only requirements that hold for this product surface, e.g. claude-connectors or claude-plugins.",
            "type": "string",
            "enum": [
              "claude-connectors",
              "claude-plugins",
              "chatgpt",
              "codex",
              "cursor-marketplace",
              "mcp-registry"
            ]
          }
        },
        "required": [
          "platform"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "platform": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "vendor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "surfaceName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "vendor",
                  "surfaceName",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "productSurface": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "category": {
                  "type": "string",
                  "minLength": 1
                },
                "categoryLabel": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceKind": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "accessed": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      }
                    },
                    "required": [
                      "label",
                      "url",
                      "accessed"
                    ],
                    "additionalProperties": false
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "conflict"
                  ]
                },
                "conflictNote": {
                  "type": "string",
                  "minLength": 1
                },
                "verifiedAt": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "verifiedBy": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "id",
                "platform",
                "productSurface",
                "category",
                "categoryLabel",
                "text",
                "evidence",
                "sourceKind",
                "sources",
                "status",
                "verifiedAt",
                "verifiedBy",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "citation": {
            "type": "object",
            "properties": {
              "dataset": {
                "type": "string"
              },
              "schemaVersion": {
                "type": "string"
              },
              "dateModified": {
                "type": "string"
              },
              "license": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "url"
                ],
                "additionalProperties": false
              },
              "attribution": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "dataset",
